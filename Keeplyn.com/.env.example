# Server-only Stripe credentials. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=replace_with_a_rotated_test_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_a_test_webhook_signing_secret

# Keeps accidental live keys from being accepted while this integration is tested.
# Set to false only as part of a deliberate live-mode launch.
STRIPE_TEST_MODE_ONLY=true

# Canonical origin used for Stripe success and cancellation redirects.
KEEPYLN_SITE_URL=http://localhost:3000

# Optional Stripe Tax code for website-design services. If omitted, Stripe uses
# the preset product tax code configured in Stripe Tax settings.
STRIPE_WEBSITE_SERVICE_TAX_CODE=

# Durable webhook event ledger supplied by the Vercel Upstash integration.
# Local development falls back to an in-memory ledger when these are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
