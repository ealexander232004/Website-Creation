# The warehouse database defaults to lead_warehouse. Keep credentials in a
# private .env file; never commit live database or proxy credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gmaps_scraper
POSTGRES_PASSWORD=replace-me
FACEBOOK_POSTGRES_DB=lead_warehouse

# Optional single, fixed egress route for a worker process. The runner does not
# rotate routes after a login wall, challenge, or rate-limit response.
# FACEBOOK_PROXY_URL=http://username:password@proxy.example:8001
